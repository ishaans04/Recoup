# Recoup — environment template
#
# Copy to .env and fill in only what you need:
#
#     cp .env.example .env
#
# EVERY KEY BELOW IS OPTIONAL. Recoup starts, runs a full 50-transaction batch and
# passes its whole test suite with this file empty or absent. A missing credential
# is not an error — it selects the mock implementation for that service, so the
# money-safe core never depends on having a telephony account or a live gateway.
#
# The phase annotation on each key is when it starts being used. Before that phase,
# setting it changes nothing.
#
# Test-mode credentials only. Never put a production key in this file or in .env.


# ---------------------------------------------------------------------------
# Operating mode — phase 0
# ---------------------------------------------------------------------------

# mock | live
# mock  : every external service is simulated. The default, and the demo default.
# live  : real Razorpay / Groq / Twilio calls, for the services whose keys are set.
# The safe mode is the one you get by doing nothing.
RECOUP_MODE=mock

# SQLAlchemy URL for the audit and work-item store. SQLite by default: zero setup,
# zero network failure points, one inspectable file. Swap in a Postgres URL and the
# schema is unchanged.
DATABASE_URL=sqlite:///./recoup.db


# ---------------------------------------------------------------------------
# Policy caps — phase 6 (the constraint gate)
# ---------------------------------------------------------------------------
# These are the hard limits from PRD section 12.2. They are not credentials and
# they are never unset; the values below are the defaults, shown so they can be
# tuned per merchant without reading the source.

# Escalate rather than retry once a work item has been retried this many times.
MAX_RETRIES=3

# Amount cap in PAISE. 5000000 paise = Rs 50,000.
# All money in Recoup is integer paise. Never a float, never rupees.
MAX_AMOUNT_PAISE=5000000

# Confidence floor for acting on an LLM diagnosis, 0.0 to 1.0. Below it, no money
# action is guessed: the item takes the safest bounded action or goes to a human.
MIN_LLM_CONFIDENCE=0.7


# ---------------------------------------------------------------------------
# Diagnosis — phase 11 (Groq, Tier-2 LLM)
# ---------------------------------------------------------------------------
# Unset: the deterministic rules table handles everything it can match, and
# anything it cannot becomes cause=unknown with source=fallback.
# Get one free, no card, at https://console.groq.com
GROQ_API_KEY=


# ---------------------------------------------------------------------------
# Payments — phases 7 and 12 (Razorpay, test mode)
# ---------------------------------------------------------------------------
# Unset: the mock gateway is used. It can be told to fail on demand, which is how
# the circuit breaker is demonstrated.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# HMAC secret for webhook signature verification. Unset, the webhook route rejects
# every request and only the demo-injection endpoint can create work items — an
# unverified webhook is not an acceptable source of money actions.
RAZORPAY_WEBHOOK_SECRET=


# ---------------------------------------------------------------------------
# SMS and email nudges — phase 13
# ---------------------------------------------------------------------------
# Unset: both channels are mocked and report delivery without sending anything.
# Twilio's trial credit covers SMS; trial accounts can only message verified numbers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Transactional email. Resend's free tier is ~100/day.
RESEND_API_KEY=


# ---------------------------------------------------------------------------
# Voice recovery call — phase 14
# ---------------------------------------------------------------------------
# Uses the same TWILIO_* credentials above for the call itself.
#
# ElevenLabs is only for the high-value hero call. Unset, Twilio's native
# text-to-speech is used, which is adequate and free — and the free ElevenLabs
# character quota is small enough that spending it on every call would exhaust it.
ELEVENLABS_API_KEY=
